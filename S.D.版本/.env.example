# ===== AI 中小微企业智能财务系统 · Phase 1 配置示例 =====
# 复制本文件为 .env 后填写。所有配置均可选：不填则自动进入 Mock 演示模式（链路完整可跑，识别结果为模拟数据）。

# 识别提供方：mock | qwen | deepseek
RECOGNIZER_PROVIDER=mock

# --- 千问端口（首选，视觉识别主力，OpenAI 兼容接口）---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max

# --- 备选端口（DeepSeek，文本/科目环节实验用）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 本地数据库文件路径（默认 ./data/sd_finance.db）
SD_DB_PATH=./data/sd_finance.db

# 上传图片本地归档目录（默认 ./data/uploads）
SD_UPLOAD_DIR=./data/uploads
